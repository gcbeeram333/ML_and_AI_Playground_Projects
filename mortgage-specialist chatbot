def calc_dti(monthly_income: float, monthly_debt: float) -> float:
if monthly_income <= 0: return 1.0
return round(min(1.0, monthly_debt / monthly_income), 4)

def calc_ltv(loan_amount: float, property_value: float) -> float:
if property_value <= 0: return 1.0
return round(min(1.0, loan_amount / property_value), 4)

def est_monthly_pmt(loan_amount: float, annual_rate_pct: float, term_years: int) -> float:
# Simple PI; add escrows (tax/ins/PMI) in prod
r = (annual_rate_pct / 100) / 12
n = term_years * 12
if r == 0: return round(loan_amount / n, 2)
return round(loan_amount * (r * (1 + r) ** n) / ((1 + r) ** n - 1), 2)

def determine_program(flags: Dict[str, Any]) -> str:
# naive heuristic; replace with UW rules
if flags.get("veteran"): return "VA"
if flags.get("down_payment_pct", 0) < 3.5: return "Conventional"
if flags.get("fico", 740) < 620: return "FHA"
return "Conventional"

def generate_checklist(program: str, profile: Dict[str, Any]) -> List[str]:
base = [
"Government ID", "2 months bank statements", "Most recent mortgage statement (if applicable)",
"Purchase agreement (if ratified)", "Homeowners insurance quote (prior to close)"
]
if program in ("Conventional","Jumbo"):
base += ["W-2s (2 years) or 1099s (2 years)", "Pay stubs (last 30 days)", "Tax returns (2 years if self-employed)"]
if program == "FHA":
base += ["FHA Amendatory Clause", "FHA Real Estate Certification"]
if program == "VA":
base += ["Certificate of Eligibility (COE)", "DD-214 (if applicable)"]
if profile.get("self_employed"): base += ["Year-to-date P&L", "Business bank statements (12 months)"]
if profile.get("rental_income"): base += ["Lease agreements", "Schedule E (2 years)"]
return sorted(set(base))

