def policy_rag_node(state: BotState):
q = state["messages"][-1][1] if isinstance(state["messages"][-1], tuple) else state["messages"][-1].content
docs = vs.similarity_search(q, k=4)
context = "\n".join([f"[doc{idx}] {d.page_content}" for idx, d in enumerate(docs, start=1)])
cites = [f"doc{idx}" for idx, _ in enumerate(docs, start=1)]
prompt = [
SystemMessage(content=SYSTEM_RAG),
HumanMessage(content=f"Q: {q}\n\nContext:\n{context}\n\nAnswer with citations like [doc1].")
]
ans = llm.invoke(prompt).content
return {"messages":[AIMessage(content=ans)], "citations": [c for c in cites if c in ans]}


