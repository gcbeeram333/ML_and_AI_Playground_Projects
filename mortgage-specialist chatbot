def classify_intent_node(state: BotState) -> Dict[str, Any]:
prompt = [
SystemMessage(content="Classify the user's intent for a mortgage assistant. Choose one of: prequal_calc, checklist, policy_rag, status_lookup, rate_faq, escalate_handoff, fallback. Respond with ONLY the label."),
HumanMessage(content=str(state["messages"][-1][1] if isinstance(state["messages"][-1], tuple) else state["messages"][-1].content))
]
intent_msg = llm.invoke(prompt)
label = intent_msg.content.strip().lower()
if label not in {"prequal_calc","checklist","policy_rag","status_lookup","rate_faq","escalate_handoff","fallback"}:
label = "fallback"
return {"intent": label}

def prequal_calc_node(state: BotState) -> Dict[str, Any]:
# Try to extract simple numbers from last user message if state is empty (demo); in prod parse forms/slots.
applicant = state.get("applicant", {})
loan_app = state.get("loan_app", {})
last = state["messages"][-1][1] if isinstance(state["messages"][-1], tuple) else state["messages"][-1].content

import re
def pickfloat(pat):
m = re.search(pat, last, re.I)
return float(m.group(1)) if m else None

income = applicant.get("monthly_income") or pickfloat(r"income[^0-9]*([\d,\.]+)")
debts = applicant.get("monthly_debt") or pickfloat(r"debt[^0-9]*([\d,\.]+)")
la = loan_app.get("loan_amount") or pickfloat(r"loan[^0-9]*([\d,\.]+)")
pv = loan_app.get("property_value") or pickfloat(r"(home|property|value)[^0-9]*([\d,\.]+)")
rate = loan_app.get("annual_rate_pct") or pickfloat(r"(rate|apr)[^0-9]*([\d\.]+)")
term = loan_app.get("term_years") or 30

# Normalize comma numbers
def norm(x):
if x is None: return None
return float(str(x).replace(",",""))
income, debts, la, pv, rate = map(norm, (income, debts, la, pv, rate))

# Basic metrics
dti = calc_dti(income or 0, debts or 0) if (income is not None and debts is not None) else None
ltv = calc_ltv(la or 0, pv or 0) if (la is not None and pv is not None) else None
pmt = est_monthly_pmt(la or 0, rate or 6.5, int(term))

# Respond
text = "Here’s a quick, non-binding pre-qual view (for education; not a credit decision):\n"
if dti is not None: text += f"- **DTI**: {round(dti*100,2)}%\n"
if ltv is not None: text += f"- **LTV**: {round(ltv*100,2)}%\n"
text += f"- **Est. PI payment** (no taxes/ins/PMI): ${pmt:,.0f}\n"
text += "\nRules of thumb:\n- DTI ≤ 43% is common; strong files often ≤ 36%.\n- LTV ≤ 80% avoids PMI on Conventional.\n"
text += "\nIf you share: monthly income, monthly debts, target price/down payment, we’ll refine these instantly."

return {
"messages": [AIMessage(content=text)],
"derived": {"dti": dti, "ltv": ltv, "est_payment": pmt}
}

